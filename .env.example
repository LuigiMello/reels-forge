# Reels Forge — variáveis de ambiente para conectar dados reais
#
# O app funciona 100% sem nada aqui (modo demonstração com dados simulados
# diariamente, e as páginas de avaliação caem para um exemplo local).

# --- Avaliação de conteúdo/conta com IA real (Avaliar Reels/Vídeos/Shorts e Contas/Canais) ---
# Sem nenhuma das duas chaves abaixo, essas páginas mostram um exemplo de
# demonstração em vez de uma análise real. Preencha SÓ UMA — as duas são
# gratuitas, sem cartão de crédito (usada nesta ordem: Gemini > Groq).

# Google Gemini — GRATUITA. Pegue em:
# https://aistudio.google.com/apikey (mesma conta Google do YOUTUBE_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq — GRATUITA, roda modelos Llama, respostas bem rápidas. Pegue em:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# --- Pesquisa diária automática (Instagram/TikTok/YouTube) ---
# Preencha as chaves abaixo, implemente as chamadas em
# src/lib/connectors/real-connector.ts e ligue LIVE_ENABLED em
# src/lib/connectors/registry.ts quando quiser dados reais no /pesquisa.

# Instagram (ex: RapidAPI "Instagram Scraper" ou Apify)
RAPIDAPI_KEY=

# TikTok (ex: RapidAPI "TikTok API" ou Apify)
# usa a mesma RAPIDAPI_KEY acima, ou crie uma variável separada se preferir

# YouTube Data API v3 (oficial, gratuita até certo limite generoso).
# Também é usada AGORA MESMO (sem precisar ligar LIVE_ENABLED) para dar dados
# reais de vídeo/canal do YouTube nas páginas de avaliação com IA acima.
YOUTUBE_API_KEY=
