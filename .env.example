# Reels Forge — variáveis de ambiente para conectar dados reais
#
# O app funciona 100% sem nada aqui (modo demonstração com dados simulados
# diariamente). Preencha as chaves abaixo, implemente as chamadas em
# src/lib/connectors/real-connector.ts e ligue LIVE_ENABLED em
# src/lib/connectors/registry.ts quando quiser dados reais.

# Instagram (ex: RapidAPI "Instagram Scraper" ou Apify)
RAPIDAPI_KEY=

# TikTok (ex: RapidAPI "TikTok API" ou Apify)
# usa a mesma RAPIDAPI_KEY acima, ou crie uma variável separada se preferir

# YouTube Data API v3 (oficial, gratuita até certo limite)
YOUTUBE_API_KEY=
